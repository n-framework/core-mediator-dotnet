<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>NFramework.Mediator.Mediator</AssemblyName>
    <RootNamespace>NFramework.Mediator.Mediator</RootNamespace>
    <Description>NFramework mediator implementation.</Description>
    <PackageId>NFramework.Mediator.Mediator</PackageId>
    <PackageTags>mediator;cqrs;pipeline;nframework</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6" />
    <PackageReference Include="UnionRailway" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NFramework.Mediator.Abstractions\NFramework.Mediator.Abstractions.csproj" />
    <!--
      Build-order dependency only: ensures the generator is compiled before this package is packed,
      WITHOUT activating it as an analyzer here (this package declares no IRailRequest types, so
      self-running it would emit an empty registration class that collides with the consumer's).
    -->
    <ProjectReference Include="..\NFramework.Mediator.Mediator.Generators\NFramework.Mediator.Mediator.Generators.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all" />
  </ItemGroup>

  <!--
    Ship the generator inside this package as an analyzer so consumers emit their own closed
    registrations. Only collected during Pack, and only when the generator output exists, so a
    transitive Release build of this package by a consumer does not fail on a missing path.
  -->
  <Target Name="IncludeRailwayGeneratorInPackage" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_RailwayGeneratorDll Include="..\NFramework.Mediator.Mediator.Generators\bin\$(Configuration)\netstandard2.0\NFramework.Mediator.Mediator.Generators.dll" />
      <None Include="@(_RailwayGeneratorDll)" Condition="Exists('%(FullPath)')" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
